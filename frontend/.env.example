# Copy to .env.local and adjust. .env.local is gitignored.

# Where the Next.js rewrite proxy forwards /api/* (ARCHITECTURE.md §5.3).
# Server-side only — never exposed to the browser, which is the point: the
# browser only ever sees this site's own origin, so there is no CORS and no
# cross-domain cookie problem.
BACKEND_URL=http://localhost:4000

# Used for absolute URLs in metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
