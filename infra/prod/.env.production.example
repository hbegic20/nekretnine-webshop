# Production environment for the API — the values you paste into Render's
# dashboard (Environment → Environment Variables). Placeholders only; the real
# ones never enter this repository.
#
# Everything here is validated at boot by backend/src/env.ts, which exits
# rather than starting half-configured. Getting one of these wrong produces a
# clear message in the Render logs, not a mystery at request time.

NODE_ENV=production
PORT=4000

# --- Database: Neon --------------------------------------------------------
# Copy the pooled connection string from the Neon dashboard, then CHANGE the
# sslmode it gives you.
#
#   sslmode=require       encrypts, but does NOT verify the certificate
#                         (pg sets rejectUnauthorized:false) — fine against
#                         eavesdropping, useless against impersonation
#   sslmode=verify-full   checks the certificate and the hostname. Neon's cert
#                         is signed by a public CA that Node already trusts, so
#                         this needs nothing else.
#
# Use the POOLED endpoint (the host containing "-pooler"). Neon's free compute
# allows few direct connections, and our pool opens up to 10.
DATABASE_URL=postgres://user:password@ep-something-pooler.eu-central-1.aws.neon.tech/nekretnine?sslmode=verify-full

SESSION_TTL_DAYS=30

# --- Images: Cloudflare R2 -------------------------------------------------
# The app refuses to boot in production with STORAGE_DRIVER=disk, because a
# container filesystem is wiped on every deploy and uploaded photos would
# silently disappear (ARCHITECTURE.md §6.2).
STORAGE_DRIVER=s3
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=nekretnine-images
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# Where browsers fetch the images from — the bucket's public r2.dev URL, or a
# custom domain. This is what storage.urlFor() prefixes keys with, so it must
# be publicly readable while the credentials above stay private.
S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# --- Email: Resend ---------------------------------------------------------
# The username is the literal string "resend"; the password is the API key.
MAIL_DRIVER=smtp
SMTP_URL=smtps://resend:<resend-api-key>@smtp.resend.com:465
# Must be on a domain verified in Resend, or delivery fails. The free plan
# verifies exactly one domain.
MAIL_FROM=Nekretnine <noreply@your-domain.ba>

# --- Not set here ----------------------------------------------------------
# UPLOAD_DIR and PUBLIC_UPLOAD_BASE_URL are disk-storage settings and are
# ignored when STORAGE_DRIVER=s3. Left out deliberately: an unused variable in
# a production environment is a question somebody has to answer later.
