# Copy to .env and adjust. .env is gitignored — never commit real values.

NODE_ENV=development
PORT=4000

# Matches infra/docker-compose.yml. In production this comes from the host.
DATABASE_URL=postgres://nekretnine:nekretnine@localhost:5432/nekretnine

# How many days a login lasts.
SESSION_TTL_DAYS=30

# --- Storage (ARCHITECTURE.md §6) ---------------------------------------
# disk = write to UPLOAD_DIR (development only — the app refuses to start
# with disk storage when NODE_ENV=production, because container filesystems
# are wiped on every deploy and uploads would silently vanish).
STORAGE_DRIVER=disk
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# Required only when STORAGE_DRIVER=s3. For Cloudflare R2, S3_ENDPOINT looks
# like https://<account-id>.r2.cloudflarestorage.com and S3_REGION is "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Email (ARCHITECTURE.md §6.4) ---------------------------------------
# console = print the email to stdout instead of sending it.
MAIL_DRIVER=console
MAIL_FROM=Nekretnine <noreply@example.com>
# Required only when MAIL_DRIVER=smtp, e.g. smtps://resend:<api-key>@smtp.resend.com:465
SMTP_URL=
